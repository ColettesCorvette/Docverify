# .env.example — configuration centrale des scripts docverify.
#
# Copie ce fichier en .env (gitignored) et ajuste les valeurs :
#   cp .env.example .env
#
# Chaque script charge le .env racine s'il existe, sinon il retombe sur ses
# défauts internes. Le chargement est un sourcing bash : $HOME et $VAR
# s'interpolent, et les quotes ne sont nécessaires que si une valeur a un espace.
#
# gen-llm-backend.sh est volontairement autonome (il tourne sur la machine Linux
# à GPU, pas ici) et ne lit pas ce .env.

# --- API & tests (test-api.sh, concurrency-test.sh, bench-models.sh) ---
API=http://localhost:8680
MODEL=mlx-community/Qwen2.5-VL-7B-Instruct-4bit
SAMPLES=$HOME/Desktop/LLM/ocr/samples

# --- Déploiement k3d (redeploy.sh) ---
IMAGE=docverify-docverify:latest
CLUSTER=mini-cluster
DEPLOY=docverify

# --- Recapture de l'image VM (recapture-vm.sh) ---
VM_IP=192.168.20.10
VM_USER=test
VM_DIR=$HOME/docverify-vm
ORAS=$HOME/oras-macos-vz/bin/darwin/arm64/oras
REGISTRY=localhost:5000
IMAGE_REPO=macos-vm
MANIFEST=deploy/k8s/macos.yaml
REG_CONTAINER=k3d-registry

# --- Wiki Gitea (push-wiki.sh) ---
WIKI_REMOTE=ssh://git@git.int.orbinea.example:2222/tfuchs/docverify.wiki.git
WIKI_DIR=$HOME/docverify-wiki
