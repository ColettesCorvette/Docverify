# LB de flotte docverify, phase 2 shared-nothing.
#
# Repartit le trafic HTTP entrant de Regia sur les unites docverify autonomes,
# une par Mac. Chaque upstream est le :8680 publie par k3d sur le LAN du Mac.
# Le LB ne touche jamais aux DMR : chaque Mac parle a son DMR Metal local.
#
# Health-check actif sur /health : un Mac dont docverify ou le DMR local est
# tombe sort automatiquement de la rotation. C'est ce qui couvre le GPU hang.
#
# Lancer sur le Mac principal ou un hote front :
#   docker run -d --name docverify-lb -p 8680:8680 \
#     -v "$PWD/deploy/fleet/Caddyfile:/etc/caddy/Caddyfile" caddy:2
# ou en local : caddy run --config deploy/fleet/Caddyfile
{
	admin off
}

:8680 {
	reverse_proxy {
		# Une ligne par Mac de la flotte, a renseigner selon l'environnement.
		# Les IP ne sont pas stables tant que les Macs ne sont pas en place :
		# prevoir une reservation DHCP par Mac, ou des noms .local si le reseau
		# resout le Bonjour, plutot que des IP en dur sujettes a changer.
		to 192.168.30.42:8680
		# to 192.168.30.xxx:8680
		# to 192.168.30.xxx:8680
		# to 192.168.30.xxx:8680

		lb_policy least_conn

		health_uri /health
		health_interval 5s
		health_timeout 2s
		health_status 200

		# Couvre le jobTimeout de 90s du pipeline en mode synchrone.
		transport http {
			dial_timeout 5s
			response_header_timeout 120s
			read_timeout 120s
			write_timeout 120s
		}
	}
}
