# LB de flotte docverify, phase 2 shared-nothing dynamique.
# Ce fichier est généré dynamiquement à partir de Caddyfile.template.
# N'éditez pas directement deploy/fleet/Caddyfile, il sera écrasé.
{
	admin off
}

:8680 {
	reverse_proxy {
		# {{UPSTREAMS}}

		lb_policy least_conn

		health_uri /health
		health_interval 5s
		health_timeout 2s
		health_status 200

		# Couvre le jobTimeout de 90s (ou 120s) du pipeline en mode synchrone.
		transport http {
			dial_timeout 5s
			response_header_timeout 120s
			read_timeout 120s
			write_timeout 120s
		}
	}
}
