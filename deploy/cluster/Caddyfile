# LB de cluster docverify, shared-nothing. Fichier STATIQUE, source de vérité,
# édité à la main. Une ligne `to <IP>:8680` par Mac (IP DHCP-réservées).
# Un Mac down ou au DMR hangé sort tout seul de la rotation via le
# health-check actif /health. Ajout/retrait d'un Mac : éditer ce fichier
# puis `caddy reload --config deploy/cluster/Caddyfile`.
#
# Lancer sur le Mac principal ou un hote front. --restart unless-stopped :
# sinon le conteneur ne remonte pas au reboot (Docker Desktop redémarre les
# conteneurs persistants au login, mais pas ceux en restart=no).
#   docker run -d --name docverify-lb --restart unless-stopped -p 8080:8080 \
#     -v "$PWD/deploy/cluster/Caddyfile:/etc/caddy/Caddyfile" caddy:2
# Conteneur déjà créé sans la policy : docker update --restart unless-stopped docverify-lb
# ou en local : caddy run --config deploy/cluster/Caddyfile
{
	# Admin sur loopback uniquement : permet `caddy reload`/`caddy stop`
	# (rechargement à chaud lors d'un ajout/retrait de Mac) sans exposer
	# de surface réseau. NE PAS binder sur 0.0.0.0.
	admin localhost:2019
}

:8080 {
	reverse_proxy {
		# Une ligne par Mac du cluster (IP DHCP-réservées). Ajout/retrait :
		# éditer ces lignes puis `caddy reload`.
		# Le Mac principal (48 Go) sert aussi de worker : le LB tourne sur lui.
		# Son IP WireGuard, comme les workers : stable (assignée par la conf wg,
		# pas DHCP) et joignable du conteneur LB comme de l'hôte. Pas 127.0.0.1,
		# qui pour un LB conteneurisé désigne le conteneur, pas l'hôte.
		to 10.40.100.15:8680
		to 10.40.1.10:8680
		to 10.40.1.11:8680
		to 10.40.1.12:8680

		lb_policy least_conn

		health_uri /health
		health_interval 5s
		health_timeout 2s
		health_status 200

		# Doit survivre au pire cas du pipeline : queueTimeout 45s PUIS
		# execTimeout 120s, soit ~165s avant le verdict. À 120s, Caddy
		# coupait avant que docverify rende son `unreadable` 200 → 504 brut.
		# 180s garantit que le client reçoit toujours le verdict gracieux.
		transport http {
			dial_timeout 5s
			response_header_timeout 180s
			read_timeout 180s
			write_timeout 180s
		}
	}
}
