<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.orbinea.macos-vz-kubelet</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/dev/macos-vz-kubelet/bin/macos-vz-kubelet</string>
        <string>--nodename</string>
        <string>macos-vz-mini</string>
        <string>--provider-id</string>
        <string>provider://e8a3c0e2-1c1d-4d8a-bf2d-2b8c1f6f9d3a</string>
        <string>--no-verify-clients</string>
        <string>--log-level</string>
        <string>info</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/dev</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>KUBECONFIG</key>
        <string>/Users/dev/.kube/config</string>
        <key>APISERVER_CERT_LOCATION</key>
        <string>/Users/dev/.kube/k3d-tls/tls.crt</string>
        <key>APISERVER_KEY_LOCATION</key>
        <string>/Users/dev/.kube/k3d-tls/tls.key</string>
        <key>APISERVER_CA_CERT_LOCATION</key>
        <string>/Users/dev/.kube/k3d-tls/ca.crt</string>
        <key>DOCKER_HOST</key>
        <string>unix:///Users/dev/.colima/default/docker.sock</string>
        <key>VZ_SSH_USER</key>
        <string>test</string>
        <key>VZ_SSH_PASSWORD</key>
        <string>CHANGE_ME</string>
    </dict>

    <key>WorkingDirectory</key>
    <string>/Users/dev</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
        <key>Crashed</key>
        <true/>
    </dict>

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>/Users/dev/Library/Logs/macos-vz-kubelet/stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/dev/Library/Logs/macos-vz-kubelet/stderr.log</string>

    <key>ProcessType</key>
    <string>Interactive</string>
</dict>
</plist>
